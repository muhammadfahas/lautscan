# ==============================================================================
# LAUT SCAN: Environment Configuration Example
# Copy to `infra/.env` for Docker Compose or `.env` for local backend runs.
# Never commit real credentials or `.env` files to version control.
# ==============================================================================

# === PostgreSQL / PostGIS =====================================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=lautscan
POSTGRES_USER=lautscan
POSTGRES_PASSWORD=your_secure_db_password_here

# Inside Docker Compose, connect to host `db`.
# For local non-Docker `uvicorn` runs, change host `db` -> `127.0.0.1`:
#   postgresql+asyncpg://lautscan:your_secure_db_password_here@127.0.0.1:5432/lautscan
DATABASE_URL=postgresql+asyncpg://lautscan:your_secure_db_password_here@db:5432/lautscan

# === Redis (API Cache & ARQ Worker Queue) =====================================
REDIS_HOST=redis
REDIS_PORT=6379
# Inside Docker Compose, connect to host `redis`.
# For local non-Docker runs, change host `redis` -> `127.0.0.1`:
#   redis://127.0.0.1:6379/0
REDIS_URL=redis://redis:6379/0

# === Raster Tile Cache & Backend API ==========================================
TILE_CACHE_DIR=/data/tiles
API_BASE_URL=http://127.0.0.1:8080
API_PORT=8080
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Open Marine Data Sources (P1 Defaults, No Token Required) ================
NOAA_ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap
OBIS_API_BASE_URL=https://api.obis.org/v3

# === Copernicus Marine Service (Optional P1 Batch ETL) ========================
# Requires a free Copernicus Marine account: https://marine.copernicus.eu/
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# === KKP PDPI (Optional Pluggable Adapter) ====================================
# Leave blank unless an authorized KKP PDPI feed/WMS endpoint is configured.
PDPI_BASE_URL=

# === Global Fishing Watch (P2: STRICTLY OPT-IN & NON-COMMERCIAL ONLY) =========
# COMPLIANCE NOTICE:
# GFW API v3 free tier tokens are strictly limited to NON-COMMERCIAL / public-
# interest usage. Commercial operators MUST obtain a licensed GFW BYO-Token
# separately so GFW licensing terms do not conflict with LAUT SCAN's MIT license.
# Leave blank to keep the GFW layer disabled.
GFW_API_TOKEN=
