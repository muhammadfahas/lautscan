{
  "name": "LAUT SCAN",
  "short_name": "LAUT SCAN",
  "id": "com.lautscan.app",
  "start_url": "/",
  "display": "standalone",
  "description": "Open-Source Marine Intelligence Platform: Know the Ocean. Find the Fish.",
  "app": {
    "id": "com.lautscan.app",
    "name": "LAUT SCAN"
  },
  "modules": [
    "marine-map"
  ],
  "packages": {
    "@lautscan/marine-map": {
      "web": {
        "tiles": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "attribution": "© OpenStreetMap contributors",
        "maxZoom": 14
      }
    }
  },
  "env": [
    "API_BASE_URL"
  ],
  "commands": {
    "server": [
      "python",
      "-m",
      "uvicorn",
      "app.main:app",
      "--app-dir",
      "../backend",
      "--port",
      "8080"
    ]
  },
  "server": {
    "database": false
  }
}
