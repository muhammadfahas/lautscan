// ocean_map.contract - LAUT SCAN 4 Lensa Laut Map Workspace & Kondisi Titik Card

use WppZoneRecord, MapPointInspection, DataSourceStatusRecord, UserPreferences from "../shapes.contract"

fn clampOpacity(val: number): number = max(0.1, min(1.0, round(val * 100) / 100))

fn opacityPct(val: number): string = `${round(val * 100)}%`

fn absVal(x: number): number = x < 0 ? -x : x

fn parseNum(raw: string, fallback: number): number = match parseNumber(raw) { case some(v) => v, case none => fallback }

fn extractJsonNum(json: string, keyToken: string, fallback: number): number = (json.indexOf(keyToken) >= 0) ? (match first(json.slice(json.indexOf(keyToken) + keyToken.length).split(",")) { case some(seg) => match first(seg.split("}")) { case some(rawNum) => parseNum(rawNum.trim(), fallback), case none => fallback }, case none => fallback }) : fallback

fn extractWppCode(payload: string): string = payload.trim().length == 3 ? payload.trim() : ""

fn zoneLat(zones: WppZoneRecord[], code: string): number = match first(zones.filter(z => z.wpp_code == code)) { case some(z) => z.centroid_lat, case none => -2.5 }

fn zoneLon(zones: WppZoneRecord[], code: string): number = match first(zones.filter(z => z.wpp_code == code)) { case some(z) => z.centroid_lon, case none => 118.0 }

fn selectedZoneTitle(zones: WppZoneRecord[], code: string): string = code == "" ? "Semua Perairan" : (match first(zones.filter(z => z.wpp_code == code)) { case some(z) => `${z.name} (${z.waters_id})`, case none => `WPP-NRI ${code}` })

fn zoomScaleLabel(z: number): string = z < 4.5 ? "Skala Regional" : (z < 6.0 ? "Skala Nusantara" : (z < 7.8 ? "Perairan Wilayah" : "Detail Perairan Selat"))

fn activeLensInsight(lens: string, useF: bool, useMs: bool): string = lens == "potential" ? "Warna keemasan menandai pertemuan suhu nyaman dan pakan plankton subur" : (lens == "sst" ? (useF ? "Rentang nyaman ikan pelagis di kisaran 81 hingga 85 °F" : "Rentang nyaman ikan pelagis di kisaran 27 hingga 29.5 °C") : (lens == "chlorophyll" ? "Warna hijau terang menandai perairan subur plankton makanan ikan kecil" : (useMs ? "Aliran biru tenang (<0.15 m/s), hijau mengalir (0.15-0.46 m/s), jingga deras (>0.46 m/s)" : "Aliran biru tenang (<0.3 kt), hijau mengalir (0.3-0.9 kt), jingga deras (>0.9 kt)")))

fn formatFreshnessSource(sources: DataSourceStatusRecord[], inspection: option<MapPointInspection>): string = match inspection { case some(pt) => pt.attribution, case none => match first(sources.filter(s => s.source_key == "noaa_erddap")) { case some(src) => `${src.display_name} (${src.status})`, case none => "NOAA CoastWatch & OBIS" } }

fn wibMonthName(m: number): string = m == 1 ? "Jan" : (m == 2 ? "Feb" : (m == 3 ? "Mar" : (m == 4 ? "Apr" : (m == 5 ? "Mei" : (m == 6 ? "Jun" : (m == 7 ? "Jul" : (m == 8 ? "Agu" : (m == 9 ? "Sep" : (m == 10 ? "Okt" : (m == 11 ? "Nov" : "Des"))))))))))

fn pad2Num(n: number): string = n < 10 ? `0${n}` : `${n}`

fn civilToDays(y: number, m: number, d: number): number = (((y - (m <= 2 ? 1 : 0)) - floor((y - (m <= 2 ? 1 : 0)) / 400) * 400) * 365 + floor(((y - (m <= 2 ? 1 : 0)) - floor((y - (m <= 2 ? 1 : 0)) / 400) * 400) / 4) - floor(((y - (m <= 2 ? 1 : 0)) - floor((y - (m <= 2 ? 1 : 0)) / 400) * 400) / 100) + floor((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1) + floor((y - (m <= 2 ? 1 : 0)) / 400) * 146097 - 719468

fn formatDayMonthWib(baseY: number, doy: number, mp: number, hh: number, mm: number): string = `${pad2Num(doy - floor((153 * mp + 2) / 5) + 1)} ${wibMonthName(mp + (mp < 10 ? 3 : -9))} ${baseY + ((mp + (mp < 10 ? 3 : -9)) <= 2 ? 1 : 0)}, ${pad2Num(hh)}:${pad2Num(mm)} WIB`

fn formatMpDoyWib(baseY: number, doy: number, hh: number, mm: number): string = formatDayMonthWib(baseY, doy, floor((5 * doy + 2) / 153), hh, mm)

fn formatYoeDoyWib(era: number, doe: number, yoe: number, hh: number, mm: number): string = formatMpDoyWib(yoe + era * 400, doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100)), hh, mm)

fn formatEraDoeWib(era: number, doe: number, hh: number, mm: number): string = formatYoeDoyWib(era, doe, floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365), hh, mm)

fn formatDaysClockWib(z: number, hh: number, mm: number): string = formatEraDoeWib(floor(z / 146097), z - floor(z / 146097) * 146097, hh, mm)

fn formatWibTotalMins(totalMins: number): string = formatDaysClockWib(floor(totalMins / 1440) + 719468, floor((totalMins - floor(totalMins / 1440) * 1440) / 60), (totalMins - floor(totalMins / 1440) * 1440) % 60)

fn tzOffsetShift(raw: string): number = (raw.length >= 25 and (raw.slice(19, 20) == "+" or raw.slice(19, 20) == "-")) ? (match parseNumber(raw.slice(19, 22)) { case some(oh) => match parseNumber(raw.slice(23, 25)) { case some(om) => 420 - (oh < 0 ? oh * 60 - om : oh * 60 + om), case none => 420 }, case none => 420 }) : 420

fn formatDateOnlyWib(raw: string): string = match parseNumber(raw.slice(5, 7)) { case some(m) => match parseNumber(raw.slice(8, 10)) { case some(d) => `${pad2Num(d)} ${wibMonthName(m)} ${raw.slice(0, 4)} (WIB)`, case none => raw }, case none => raw }

fn formatIsoUtcWib(raw: string): string = match parseNumber(raw.slice(0, 4)) { case some(y) => match parseNumber(raw.slice(5, 7)) { case some(m) => match parseNumber(raw.slice(8, 10)) { case some(d) => match parseNumber(raw.slice(11, 13)) { case some(hh) => match parseNumber(raw.slice(14, 16)) { case some(mm) => formatWibTotalMins(civilToDays(y, m, d) * 1440 + hh * 60 + mm + tzOffsetShift(raw)), case none => raw }, case none => raw }, case none => raw }, case none => raw }, case none => raw }

fn formatWibTimestamp(raw: string): string = raw == "latest" ? "Terbaru (Hari Ini · WIB)" : ((raw.length == 10 and raw.indexOf("-") == 4) ? formatDateOnlyWib(raw) : ((raw.length >= 16 and raw.slice(4, 5) == "-" and raw.slice(7, 8) == "-") ? formatIsoUtcWib(raw) : raw))

fn formatWibOpt(val: option<string>, fallback: string): string = match val { case some(s) => formatWibTimestamp(s), case none => fallback }

fn formatFreshnessTimestamp(sources: DataSourceStatusRecord[], inspection: option<MapPointInspection>): string = match inspection { case some(pt) => formatWibOpt(pt.acquired_at_utc, "Basis data lokal"), case none => match first(sources.filter(s => s.source_key == "noaa_erddap")) { case some(src) => match src.latest_data_timestamp_utc { case some(ts) => formatWibTimestamp(ts), case none => formatWibOpt(src.last_sync_utc, "Basis data lokal") }, case none => "Basis data lokal" } }

fn formatOptNumber(val: option<number>, decimals: number, unit: string): string = match val { case some(v) => `${decimals == 0 ? v.toFixed(0) : (decimals == 1 ? v.toFixed(1) : v.toFixed(2))} ${unit}`, case none => "Tidak tersedia" }

fn formatOptText(val: option<string>, fallback: string): string = match val { case some(s) => s, case none => fallback }

fn activeOpacityValue(lens: string, potOp: number, sstOp: number, chlOp: number, curOp: number): number = lens == "potential" ? potOp : (lens == "sst" ? sstOp : (lens == "chlorophyll" ? chlOp : curOp))

fn sstComfortLabel(val: option<number>): string = match val { case some(c) => (c >= 26.0 and c <= 30.0) ? "Nyaman" : (c > 30.0 ? "Hangat" : "Sejuk"), case none => "Tidak terukur" }

fn chlRichnessLabel(val: option<number>): string = match val { case some(c) => c >= 0.45 ? "Subur Plankton" : (c >= 0.18 ? "Cukup" : "Jernih"), case none => "Berawan / Pesisir" }

fn chlMeterPercent(val: option<number>): string = match val { case some(c) => `${max(12, min(100, round((c / 1.2) * 100)))}%`, case none => "0%" }

fn currentStrengthLabel(kn: option<number>): string = match kn { case some(v) => v >= 0.9 ? "Deras" : (v >= 0.3 ? "Mengalir" : "Tenang"), case none => "Tidak terukur" }

fn compassDirId(code: option<string>): string = match code { case some(raw) => raw == "N" ? "Utara" : ((raw == "NE" or raw == "NNE" or raw == "ENE") ? "Timur Laut" : (raw == "E" ? "Timur" : ((raw == "SE" or raw == "ESE" or raw == "SSE") ? "Tenggara" : (raw == "S" ? "Selatan" : ((raw == "SW" or raw == "SSW" or raw == "WSW") ? "Barat Daya" : (raw == "W" ? "Barat" : ((raw == "NW" or raw == "WNW" or raw == "NNW") ? "Barat Laut" : raw))))))), case none => "Arah variabel" }

fn compassDeg(deg: option<number>): number = match deg { case some(d) => round(d), case none => 0 }

fn sstScoreNum(sst: option<number>): number = match sst { case some(t) => max(20, min(100, round(100 - absVal(t - 28.5) * 14))), case none => 65 }

fn chlScoreNum(chl: option<number>): number = match chl { case some(c) => max(15, min(100, round((min(c, 1.2) / 1.2) * 100))), case none => 55 }

fn curScoreNum(curKn: option<number>): number = match curKn { case some(k) => (k <= 0.8 ? 94 : (k <= 1.4 ? 75 : 48)), case none => 80 }

fn potentialPct(sst: option<number>, chl: option<number>, curKn: option<number>): number = round(0.40 * sstScoreNum(sst) + 0.45 * chlScoreNum(chl) + 0.15 * curScoreNum(curKn))

fn potentialVerdict(sst: option<number>, chl: option<number>, curKn: option<number>): string = match sst { case some(_) => potentialPct(sst, chl, curKn) >= 72 ? "Padat Potensi" : (potentialPct(sst, chl, curKn) >= 46 ? "Potensi Sedang" : "Area Sepi"), case none => match chl { case some(_) => potentialPct(sst, chl, curKn) >= 72 ? "Padat Potensi" : (potentialPct(sst, chl, curKn) >= 46 ? "Potensi Sedang" : "Area Sepi"), case none => "Luar Laut" } }

fn potentialVerdictColor(sst: option<number>, chl: option<number>, curKn: option<number>): string = potentialPct(sst, chl, curKn) >= 72 ? "#16A34A" : (potentialPct(sst, chl, curKn) >= 46 ? "#0284C7" : "#64748B")

fn currentPhraseText(curKn: option<number>, curMs: option<number>, useMs: bool): string = match curKn { case some(k) => k >= 0.9 ? `, namun waspadai arus deras (${useMs ? formatOptNumber(curMs, 2, "m/s") : `${k.toFixed(2)} kt`})` : ` dengan arus ${currentStrengthLabel(curKn)} (${useMs ? formatOptNumber(curMs, 2, "m/s") : `${k.toFixed(2)} kt`})`, case none => "tenang" }

fn pointTakeawayText(pt: MapPointInspection, useF: bool, useMs: bool): string = match pt.sst_c { case some(t) => match pt.chlorophyll_mg_m3 { case some(ch) => potentialPct(pt.sst_c, pt.chlorophyll_mg_m3, pt.current_speed_knots) >= 72 ? `Potensi padat: suhu ${useF ? formatOptNumber(pt.sst_f, 1, "°F") : `${t.toFixed(1)} °C`} (${sstComfortLabel(pt.sst_c)}) bertemu pakan ${chlRichnessLabel(some(ch))} (${ch.toFixed(2)} mg/m3)${currentPhraseText(pt.current_speed_knots, pt.current_speed_ms, useMs)}.` : (ch < 0.18 ? `Suhu ${useF ? formatOptNumber(pt.sst_f, 1, "°F") : `${t.toFixed(1)} °C`} (${sstComfortLabel(pt.sst_c)}) mendukung, namun pakan masih ${chlRichnessLabel(some(ch))} (${ch.toFixed(2)} mg/m3) sehingga ikan tersebar${currentPhraseText(pt.current_speed_knots, pt.current_speed_ms, useMs)}.` : `Peluang sedang: suhu ${useF ? formatOptNumber(pt.sst_f, 1, "°F") : `${t.toFixed(1)} °C`} (${sstComfortLabel(pt.sst_c)}) dan pakan ${chlRichnessLabel(some(ch))} (${ch.toFixed(2)} mg/m3)${currentPhraseText(pt.current_speed_knots, pt.current_speed_ms, useMs)}.`), case none => `Suhu ${useF ? formatOptNumber(pt.sst_f, 1, "°F") : `${t.toFixed(1)} °C`} (${sstComfortLabel(pt.sst_c)})${currentPhraseText(pt.current_speed_knots, pt.current_speed_ms, useMs)}; data plankton pesisir sedang berawan.` }, case none => match pt.chlorophyll_mg_m3 { case some(ch) => `Kadar plankton ${chlRichnessLabel(some(ch))} (${ch.toFixed(2)} mg/m3) terdeteksi di perairan ini${currentPhraseText(pt.current_speed_knots, pt.current_speed_ms, useMs)}.`, case none => "Tidak ada data perairan laut di koordinat ini. Ketuk area laut untuk melihat kondisi." } }

component OceanMapView
  props
    wppZones: WppZoneRecord[]
    wppGeoJsonCollection: string
    speciesMarkers: string
    pointInspection: option<MapPointInspection>
    sources: DataSourceStatusRecord[]
    prefs: UserPreferences
    apiBaseUrl: string
    onInspectPoint: action
    onClearInspection: action
    onBoundsChange: action
    onWppSelected: action

  state activeLens = "potential"
  state potentialOpacity = 0.88
  state sstOpacity = 0.62
  state chlorophyllOpacity = 0.65
  state currentsOpacity = 0.88
  state showSpeciesPins = true
  state tunePanelOpen = false
  state techDetailsOpen = false
  state selectedDate = "latest"
  state selectedWppCode = ""
  state centerLat = -2.5
  state centerLon = 118.0
  state zoom = 5
  state inspectorOpen = false

  derive baseStyle = prefs.theme_mode == "night" ? "night" : "daylight"
  derive potentialVisible = activeLens == "potential"
  derive sstVisible = activeLens == "sst"
  derive chlorophyllVisible = activeLens == "chlorophyll"
  derive currentsVisible = activeLens == "currents"
  derive activeOpacity = activeOpacityValue(activeLens, potentialOpacity, sstOpacity, chlorophyllOpacity, currentsOpacity)
  derive useFahrenheit = prefs.temp_unit == "F"
  derive useMs = prefs.speed_unit == "ms"
  derive freshnessSource = formatFreshnessSource(sources, pointInspection)
  derive freshnessTimestamp = formatFreshnessTimestamp(sources, pointInspection)
  derive showInspector = match pointInspection { case some(_) => true, case none => inspectorOpen }

  action setLens(lens: string)
    activeLens = lens

  action toggleTunePanel()
    tunePanelOpen = not tunePanelOpen

  action toggleSpeciesPins()
    showSpeciesPins = not showSpeciesPins

  action toggleTechDetails()
    techDetailsOpen = not techDetailsOpen

  action stepActiveOpacity(delta: number)
    if activeLens == "potential"
      potentialOpacity = clampOpacity(potentialOpacity + delta)
    else if activeLens == "sst"
      sstOpacity = clampOpacity(sstOpacity + delta)
    else if activeLens == "chlorophyll"
      chlorophyllOpacity = clampOpacity(chlorophyllOpacity + delta)
    else
      currentsOpacity = clampOpacity(currentsOpacity + delta)

  action setOpacityPreset(presetVal: number)
    if activeLens == "potential"
      potentialOpacity = clampOpacity(presetVal)
    else if activeLens == "sst"
      sstOpacity = clampOpacity(presetVal)
    else if activeLens == "chlorophyll"
      chlorophyllOpacity = clampOpacity(presetVal)
    else
      currentsOpacity = clampOpacity(presetVal)

  action setActiveOpacity(value: number)
    if activeLens == "potential"
      potentialOpacity = clampOpacity(value)
    else if activeLens == "sst"
      sstOpacity = clampOpacity(value)
    else if activeLens == "chlorophyll"
      chlorophyllOpacity = clampOpacity(value)
    else
      currentsOpacity = clampOpacity(value)

  action selectWpp(code: string)
    selectedWppCode = code
    if code == ""
      centerLat = -2.5
      centerLon = 118.0
      zoom = 5
    else
      centerLat = zoneLat(wppZones, code)
      centerLon = zoneLon(wppZones, code)
      zoom = 6
    onWppSelected(code)

  action selectDate(dateVal: string)
    selectedDate = dateVal
    if showInspector
      onInspectPoint(centerLat, centerLon, dateVal)

  action inspectCenter()
    inspectorOpen = true
    techDetailsOpen = false
    onInspectPoint(centerLat, centerLon, selectedDate)

  action handleMapChange(payload: string)
    let trimmed = payload.trim()
    let code = extractWppCode(trimmed)
    if code != ""
      selectedWppCode = code
      centerLat = zoneLat(wppZones, code)
      centerLon = zoneLon(wppZones, code)
      zoom = 6
      onWppSelected(code)
    else if trimmed == ""
      selectedWppCode = ""
      centerLat = -2.5
      centerLon = 118.0
      zoom = 5
      onWppSelected("")

  action handleMapMessage(payload: string)
    if payload.indexOf("pointclick") >= 0
      let lat = extractJsonNum(payload, "\"lat\":", centerLat)
      let lon = extractJsonNum(payload, "\"lon\":", centerLon)
      inspectorOpen = true
      techDetailsOpen = false
      onInspectPoint(lat, lon, selectedDate)
    else if payload.indexOf("minLon") >= 0
      let minLon = extractJsonNum(payload, "\"minLon\":", 90.0)
      let minLat = extractJsonNum(payload, "\"minLat\":", -15.0)
      let maxLon = extractJsonNum(payload, "\"maxLon\":", 145.0)
      let maxLat = extractJsonNum(payload, "\"maxLat\":", 10.0)
      let nextLat = extractJsonNum(payload, "\"centerLat\":", centerLat)
      let nextLon = extractJsonNum(payload, "\"centerLon\":", centerLon)
      let nextZoom = extractJsonNum(payload, "\"zoom\":", zoom)
      centerLat = nextLat
      centerLon = nextLon
      zoom = nextZoom
      onBoundsChange(`${minLon.toFixed(4)},${minLat.toFixed(4)},${maxLon.toFixed(4)},${maxLat.toFixed(4)}`)

  action closeInspector()
    inspectorOpen = false
    techDetailsOpen = false
    onClearInspection()

  view
    column width="100%" flex=1 min-height="84vh" overflow-x="hidden" background-color="var(--surface-canvas)" color="var(--ink-primary)" testId="ocean-map-workspace"
      box width="100%" flex=1 min-height="78vh" position="relative" overflow="hidden" z-index=10 testId="ocean-map-canvas-wrap"
        marine-map centerLat=centerLat centerLon=centerLon zoomLevel=zoom baseStyle=baseStyle potentialVisible=potentialVisible potentialOpacity=potentialOpacity sstVisible=sstVisible sstOpacity=sstOpacity chlorophyllVisible=chlorophyllVisible chlorophyllOpacity=chlorophyllOpacity currentsVisible=currentsVisible currentsOpacity=currentsOpacity showSpeciesPins=showSpeciesPins selectedDate=selectedDate tileBaseUrl=apiBaseUrl wppGeoJsonCollection=wppGeoJsonCollection selectedWppCode=selectedWppCode speciesMarkers=speciesMarkers change=handleMapChange message=handleMapMessage width="100%" height="100%" min-height="78vh" testId="marine-map-canvas"

        // Top-Left Slim Quick Controls & Zoom Insight Pill
        column position="absolute" top=12 left=12 max-width="calc(100% - 24px)" gap=8 align-items="flex-start" z-index=20
          row width="100%" max-width="100%" gap=8 flex-wrap="wrap" align-items="center" testId="top-quick-controls"
            select value=selectedWppCode change=selectWpp min-height=44 min-width=180 max-width=260 padding="8px 12px" border-radius=999 border="1px solid var(--border-subtle)" background-color="var(--surface-elevated)" color="var(--ink-primary)" font-size=14 font-weight=600 cursor="pointer" aria-label="Pilih Wilayah Laut WPP-NRI" testId="wpp-zone-select"
              option "Semua Perairan Indonesia" value=""
              for z in wppZones key=z.wpp_code
                option `${z.name}: ${z.waters_id}` value=z.wpp_code

            button press=toggleSpeciesPins min-height=44 min-width=44 padding="8px 14px" border-radius=999 border=(showSpeciesPins ? "1px solid var(--accent-primary)" : "1px solid var(--border-subtle)") background-color=(showSpeciesPins ? "var(--accent-primary)" : "var(--surface-elevated)") color=(showSpeciesPins ? "#FFFFFF" : "var(--ink-primary)") cursor="pointer" aria-pressed=showSpeciesPins aria-label="Tampilkan titik tangkapan ikan" testId="toggle-species-pins"
              row align-items="center" gap=6
                svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  path d="M6.5 12c.94-3.46 4.94-6 8.5-6 3.56 0 6.06 2.54 7 6-.94 3.46-3.44 6-7 6-3.56 0-7.56-2.54-8.5-6Z"
                  path d="M18 12v.5"
                text "Titik Ikan" font-size=13 font-weight=600

            button press=inspectCenter min-height=44 min-width=44 padding="8px 14px" border-radius=999 border="1px solid var(--border-subtle)" background-color="var(--surface-elevated)" color="var(--ink-primary)" cursor="pointer" aria-label="Periksa kondisi di wilayah aktif" testId="inspect-center-btn"
              row align-items="center" gap=6
                svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="var(--accent-cta)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  circle cx=12 cy=12 r=10
                  line x1=22 y1=12 x2=18 y2=12
                  line x1=6 y1=12 x2=2 y2=12
                  line x1=12 y1=6 x2=12 y2=2
                  line x1=12 y1=22 x2=12 y2=18
                text "Cek Titik" font-size=13 font-weight=600

          row align-items="center" flex-wrap="wrap" gap=8 padding="7px 12px" border-radius=12 border="1px solid var(--border-subtle)" background-color="var(--surface-elevated)" max-width=640 testId="zoom-area-insight-pill"
            box padding="2px 8px" border-radius=999 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
              text `${zoomScaleLabel(zoom)} · Z${round(zoom * 10) / 10}` font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=11 font-weight=700 color="var(--accent-primary)"
            text `${selectedZoneTitle(wppZones, selectedWppCode)}: ${activeLensInsight(activeLens, useFahrenheit, useMs)}` font-size=12 color="var(--ink-muted)"

        // Floating Bottom-Center Dock: 4 Lensa Laut Pills & Tiered Legend
        column position="absolute" bottom=14 left="50%" translate="-50% 0px" width="calc(100% - 136px)" max-width=650 gap=8 z-index=22 align-items="center" testId="lensa-laut-dock"
          if tunePanelOpen
            column width="100%" max-width=380 padding="12px" gap=10 border-radius=14 background-color="var(--surface-elevated)" border="1px solid var(--border-subtle)" testId="tune-panel-popover"
              row width="100%" align-items="center" justify-content="space-between" gap=8
                text "Transparansi Lapisan" font-size=13 font-weight=700 color="var(--ink-primary)"
                text opacityPct(activeOpacity) font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=13 color="var(--ink-muted)" testId="active-opacity-value"
              row width="100%" align-items="center" gap=6
                button press=stepActiveOpacity(-0.1) min-height=44 min-width=44 padding="6px" border-radius=8 border="1px solid var(--border-subtle)" background-color="var(--surface-canvas)" color="var(--ink-primary)" cursor="pointer" aria-label="Kurangi transparansi lapisan" testId="active-opacity-down"
                  text "-" font-size=16 font-weight=700
                input type="range" min=0.1 max=1 step=0.05 value=activeOpacity change=setActiveOpacity min-height=44 min-width=44 flex=1 cursor="pointer" aria-label="Pengatur transparansi lapisan" testId="opacity-slider-active"
                button press=stepActiveOpacity(0.1) min-height=44 min-width=44 padding="6px" border-radius=8 border="1px solid var(--border-subtle)" background-color="var(--surface-canvas)" color="var(--ink-primary)" cursor="pointer" aria-label="Tambah transparansi lapisan" testId="active-opacity-up"
                  text "+" font-size=16 font-weight=700
              row width="100%" align-items="center" gap=6
                button press=setOpacityPreset(0.4) flex=1 min-height=44 min-width=44 padding="6px 8px" border-radius=8 border=(absVal(activeOpacity - 0.4) <= 0.02 ? "1px solid var(--accent-primary)" : "1px solid var(--border-subtle)") background-color="var(--surface-canvas)" color=(absVal(activeOpacity - 0.4) <= 0.02 ? "var(--accent-primary)" : "var(--ink-primary)") cursor="pointer" aria-label="Atur transparansi tipis 40 persen"
                  text "Tipis (40%)" font-size=12 font-weight=600
                button press=setOpacityPreset(0.7) flex=1 min-height=44 min-width=44 padding="6px 8px" border-radius=8 border=(absVal(activeOpacity - 0.7) <= 0.02 ? "1px solid var(--accent-primary)" : "1px solid var(--border-subtle)") background-color="var(--surface-canvas)" color=(absVal(activeOpacity - 0.7) <= 0.02 ? "var(--accent-primary)" : "var(--ink-primary)") cursor="pointer" aria-label="Atur transparansi seimbang 70 persen"
                  text "Seimbang (70%)" font-size=12 font-weight=600
                button press=setOpacityPreset(0.9) flex=1 min-height=44 min-width=44 padding="6px 8px" border-radius=8 border=(absVal(activeOpacity - 0.9) <= 0.02 ? "1px solid var(--accent-primary)" : "1px solid var(--border-subtle)") background-color="var(--surface-canvas)" color=(absVal(activeOpacity - 0.9) <= 0.02 ? "var(--accent-primary)" : "var(--ink-primary)") cursor="pointer" aria-label="Atur transparansi jelas 90 persen"
                  text "Jelas (90%)" font-size=12 font-weight=600
              row width="100%" align-items="center" justify-content="space-between" gap=8
                text "Tanggal Data (WIB)" font-size=12 font-weight=600 color="var(--ink-muted)"
                select value=selectedDate change=selectDate min-height=44 min-width=160 padding="8px 10px" border-radius=8 border="1px solid var(--border-subtle)" background-color="var(--surface-canvas)" color="var(--ink-primary)" font-size=13 cursor="pointer" aria-label="Pilih tanggal pengamatan" testId="date-selector"
                  option "Terbaru (Hari Ini · WIB)" value="latest"
                  option "10 Nov 2026 (WIB)" value="2026-11-10"
                  option "01 Nov 2026 (WIB)" value="2026-11-01"
                  option "15 Okt 2026 (WIB)" value="2026-10-15"

          column width="100%" padding="8px 10px" gap=8 border-radius=16 background-color="var(--surface-elevated)" border="1px solid var(--border-subtle)"
            row width="100%" align-items="center" justify-content="space-between" gap=6 flex-wrap="wrap"
              button press=setLens("potential") flex=1 min-height=44 min-width=88 padding="8px 10px" border-radius=10 border=(potentialVisible ? "1px solid var(--accent-cta)" : "1px solid transparent") background-color=(potentialVisible ? "var(--accent-cta)" : "var(--surface-canvas)") color=(potentialVisible ? "#FFFFFF" : "var(--ink-primary)") cursor="pointer" aria-pressed=potentialVisible aria-label="Lensa Zona Ikan" testId="lens-btn-potential"
                text "Zona Ikan" font-size=13 font-weight=700

              button press=setLens("sst") flex=1 min-height=44 min-width=80 padding="8px 10px" border-radius=10 border=(sstVisible ? "1px solid var(--accent-primary)" : "1px solid transparent") background-color=(sstVisible ? "var(--accent-primary)" : "var(--surface-canvas)") color=(sstVisible ? "#FFFFFF" : "var(--ink-primary)") cursor="pointer" aria-pressed=sstVisible aria-label="Lensa Suhu Air" testId="lens-btn-sst"
                text "Suhu Air" font-size=13 font-weight=700

              button press=setLens("chlorophyll") flex=1 min-height=44 min-width=96 padding="8px 10px" border-radius=10 border=(chlorophyllVisible ? "1px solid var(--accent-primary)" : "1px solid transparent") background-color=(chlorophyllVisible ? "var(--accent-primary)" : "var(--surface-canvas)") color=(chlorophyllVisible ? "#FFFFFF" : "var(--ink-primary)") cursor="pointer" aria-pressed=chlorophyllVisible aria-label="Lensa Pakan Alami" testId="lens-btn-chlorophyll"
                text "Pakan Alami" font-size=13 font-weight=700

              button press=setLens("currents") flex=1 min-height=44 min-width=88 padding="8px 10px" border-radius=10 border=(currentsVisible ? "1px solid var(--accent-primary)" : "1px solid transparent") background-color=(currentsVisible ? "var(--accent-primary)" : "var(--surface-canvas)") color=(currentsVisible ? "#FFFFFF" : "var(--ink-primary)") cursor="pointer" aria-pressed=currentsVisible aria-label="Lensa Arus Laut" testId="lens-btn-currents"
                text "Arus Laut" font-size=13 font-weight=700

              button press=toggleTunePanel min-height=44 min-width=44 padding="8px 10px" border-radius=10 border="1px solid var(--border-subtle)" background-color=(tunePanelOpen ? "var(--surface-canvas)" : "transparent") color="var(--ink-primary)" cursor="pointer" aria-expanded=tunePanelOpen aria-label="Atur transparansi dan tanggal" testId="toggle-tune-panel"
                row align-items="center" gap=4
                  svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    line x1=4 y1=21 x2=4 y2=14
                    line x1=4 y1=10 x2=4 y2=3
                    line x1=12 y1=21 x2=12 y2=12
                    line x1=12 y1=8 x2=12 y2=3
                    line x1=20 y1=21 x2=20 y2=16
                    line x1=20 y1=12 x2=20 y2=3
                  text "Atur" font-size=12 font-weight=600

            if potentialVisible
              column width="100%" gap=6 padding="2px 4px" testId="legend-potential"
                row width="100%" align-items="center" gap=10
                  text "Gabungan suhu nyaman & pakan plankton" font-size=11 font-weight=600 color="var(--ink-muted)"
                  box flex=1 height=8 border-radius=999 background-image="linear-gradient(90deg, rgba(20,184,166,0.16) 0%, #14B8A6 42%, #22C55E 72%, #F59E0B 100%)" aria-hidden="true"
                row width="100%" gap=6
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=10 height=10 border-radius=999 background-color="rgba(20,184,166,0.22)" aria-hidden="true"
                    text "Sepi (<45%)" font-variant-numeric="tabular-nums" font-size=11 font-weight=600 color="var(--ink-primary)"
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=10 height=10 border-radius=999 background-color="#22C55E" aria-hidden="true"
                    text "Sedang (45-71%)" font-variant-numeric="tabular-nums" font-size=11 font-weight=600 color="var(--ink-primary)"
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=10 height=10 border-radius=999 background-color="#F59E0B" aria-hidden="true"
                    text "Padat Potensi (>=72%)" font-variant-numeric="tabular-nums" font-size=11 font-weight=700 color="var(--ink-primary)"

            if sstVisible
              column width="100%" gap=6 padding="2px 4px" testId="legend-sst"
                row width="100%" align-items="center" gap=10
                  text "Suhu permukaan laut untuk aktivitas ikan" font-size=11 font-weight=600 color="var(--ink-muted)"
                  box flex=1 height=8 border-radius=999 background-image="linear-gradient(90deg, #0d0887 0%, #6a00a8 25%, #b12a90 50%, #e16462 72%, #fca636 88%, #f0f921 100%)" aria-hidden="true"
                row width="100%" gap=6
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=10 height=10 border-radius=999 background-color="#4c02a1" aria-hidden="true"
                    text (useFahrenheit ? "Sejuk (<79 °F)" : "Sejuk (<26 °C)") font-variant-numeric="tabular-nums" font-size=11 font-weight=600 color="var(--ink-primary)"
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=10 height=10 border-radius=999 background-color="#cc4778" aria-hidden="true"
                    text (useFahrenheit ? "Nyaman (81-85 °F)" : "Nyaman (27-29.5 °C)") font-variant-numeric="tabular-nums" font-size=11 font-weight=600 color="var(--ink-primary)"
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=10 height=10 border-radius=999 background-color="#f89540" aria-hidden="true"
                    text (useFahrenheit ? "Hangat (>86 °F)" : "Hangat (>30 °C)") font-variant-numeric="tabular-nums" font-size=11 font-weight=700 color="var(--ink-primary)"

            if chlorophyllVisible
              column width="100%" gap=6 padding="2px 4px" testId="legend-chlorophyll"
                row width="100%" align-items="center" gap=10
                  text "Kadar klorofil penanda plankton makanan ikan" font-size=11 font-weight=600 color="var(--ink-muted)"
                  box flex=1 height=8 border-radius=999 background-image="linear-gradient(90deg, #440154 0%, #3b528b 25%, #21918c 55%, #5ec962 80%, #fde725 100%)" aria-hidden="true"
                row width="100%" gap=6
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=10 height=10 border-radius=999 background-color="#440154" aria-hidden="true"
                    text "Jernih (<0.18)" font-variant-numeric="tabular-nums" font-size=11 font-weight=600 color="var(--ink-primary)"
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=10 height=10 border-radius=999 background-color="#21918c" aria-hidden="true"
                    text "Cukup (0.18-0.45)" font-variant-numeric="tabular-nums" font-size=11 font-weight=600 color="var(--ink-primary)"
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=10 height=10 border-radius=999 background-color="#5ec962" aria-hidden="true"
                    text "Subur Plankton (>0.45 mg/m3)" font-variant-numeric="tabular-nums" font-size=11 font-weight=700 color="var(--ink-primary)"

            if currentsVisible
              column width="100%" gap=6 padding="2px 4px" testId="legend-currents"
                text "Arah garis mengikuti aliran arus permukaan laut" font-size=11 font-weight=600 color="var(--ink-muted)"
                row width="100%" gap=6
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=14 height=3 border-radius=2 background-color="#0284C7" aria-hidden="true"
                    text (useMs ? "Tenang (<0.15 m/s)" : "Tenang (<0.3 kt)") font-variant-numeric="tabular-nums" font-size=11 font-weight=600 color="#0284C7"
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=14 height=3 border-radius=2 background-color="#0D9488" aria-hidden="true"
                    text (useMs ? "Mengalir (0.15-0.46 m/s)" : "Mengalir (0.3-0.9 kt)") font-variant-numeric="tabular-nums" font-size=11 font-weight=600 color="#0D9488"
                  row flex=1 min-width=0 align-items="center" justify-content="center" gap=5 padding="4px 6px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    box width=14 height=3 border-radius=2 background-color="#D97706" aria-hidden="true"
                    text (useMs ? "Deras (>0.46 m/s)" : "Deras (>0.9 kt)") font-variant-numeric="tabular-nums" font-size=11 font-weight=700 color="#D97706"

        // Kondisi Titik Ini Card
        if showInspector
          column position="absolute" top=12 right=12 max-width=380 width="calc(100% - 24px)" max-height="calc(78vh - 58px)" overflow-y="auto" padding="14px" gap=10 border-radius=14 background-color="var(--surface-elevated)" border="1px solid var(--border-subtle)" z-index=30 testId="point-inspector-drawer"
            row width="100%" align-items="center" justify-content="space-between" gap=8
              row align-items="center" gap=8
                svg width=18 height=18 viewBox="0 0 24 24" fill="none" stroke="var(--accent-cta)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  circle cx=12 cy=12 r=10
                  line x1=22 y1=12 x2=18 y2=12
                  line x1=6 y1=12 x2=2 y2=12
                  line x1=12 y1=6 x2=12 y2=2
                  line x1=12 y1=22 x2=12 y2=18
                text "Kondisi Titik Ini" role="heading" font-size=16 font-weight=700 color="var(--ink-primary)"
              button press=closeInspector min-height=44 min-width=44 padding="8px" border-radius=8 border="1px solid var(--border-subtle)" background-color="var(--surface-canvas)" color="var(--ink-primary)" cursor="pointer" aria-label="Tutup kartu kondisi titik" testId="close-inspector-btn"
                svg width=18 height=18 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  line x1=18 y1=6 x2=6 y2=18
                  line x1=6 y1=6 x2=18 y2=18

            match pointInspection
              case some(pt)
                column width="100%" gap=10
                  row width="100%" align-items="center" justify-content="space-between" gap=8 padding="10px" border-radius=10 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)"
                    column flex=1 min-width=0 gap=2
                      text `${formatOptText(pt.wpp_name, "Perairan Lepas")}` font-size=14 font-weight=700 color="var(--ink-primary)" testId="inspector-wpp"
                      text formatOptText(pt.wpp_waters_id, "Wilayah perairan sekitar") font-size=12 color="var(--ink-muted)"
                    box padding="5px 10px" border-radius=999 background-color=potentialVerdictColor(pt.sst_c, pt.chlorophyll_mg_m3, pt.current_speed_knots) color="#FFFFFF"
                      text potentialVerdict(pt.sst_c, pt.chlorophyll_mg_m3, pt.current_speed_knots) font-size=12 font-weight=700

                  column width="100%" padding="10px 12px" gap=4 border-radius=10 background-color="var(--surface-canvas)" border="1px solid var(--accent-primary)" testId="inspector-takeaway"
                    text "Kesimpulan Kondisi" font-size=11 font-weight=700 color="var(--accent-primary)"
                    text pointTakeawayText(pt, useFahrenheit, useMs) font-size=13 line-height=1.45 color="var(--ink-primary)"

                  row width="100%" gap=8 flex-wrap="wrap"
                    column flex=1 min-width=130 padding="10px" gap=4 border-radius=10 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)" testId="inspector-sst"
                      row align-items="center" gap=6
                        svg width=15 height=15 viewBox="0 0 24 24" fill="none" stroke="var(--accent-cta)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                          path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"
                        text "Suhu Air" font-size=12 font-weight=600 color="var(--ink-muted)"
                      text (useFahrenheit ? formatOptNumber(pt.sst_f, 1, "°F") : formatOptNumber(pt.sst_c, 1, "°C")) font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=17 font-weight=700 color="var(--ink-primary)"
                      text sstComfortLabel(pt.sst_c) font-size=12 font-weight=600 color="var(--accent-primary)"

                    column flex=1 min-width=130 padding="10px" gap=4 border-radius=10 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)" testId="inspector-chlorophyll"
                      row align-items="center" gap=6
                        svg width=15 height=15 viewBox="0 0 24 24" fill="none" stroke="var(--status-healthy)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                          path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"
                          path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"
                        text "Pakan Alami" font-size=12 font-weight=600 color="var(--ink-muted)"
                      text chlRichnessLabel(pt.chlorophyll_mg_m3) font-size=15 font-weight=700 color="var(--ink-primary)"
                      box width="100%" height=6 border-radius=999 background-color="var(--border-subtle)" overflow="hidden"
                        box width=chlMeterPercent(pt.chlorophyll_mg_m3) height="100%" border-radius=999 background-color="var(--status-healthy)"
                      text formatOptNumber(pt.chlorophyll_mg_m3, 2, "mg/m3") font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=11 color="var(--ink-muted)"

                  row width="100%" align-items="center" justify-content="space-between" padding="10px" gap=10 border-radius=10 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)" testId="inspector-current"
                    column gap=3
                      text "Arah & Kuat Arus" font-size=12 font-weight=600 color="var(--ink-muted)"
                      text (useMs ? formatOptNumber(pt.current_speed_ms, 2, "m/s") : formatOptNumber(pt.current_speed_knots, 2, "knot")) font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=16 font-weight=700 color="var(--ink-primary)"
                      text `${currentStrengthLabel(pt.current_speed_knots)} ke ${compassDirId(pt.current_compass)}` font-size=12 font-weight=600 color="var(--accent-primary)"
                    box width=42 height=42 border-radius=999 background-color="var(--surface-elevated)" border="1px solid var(--border-subtle)" display="flex" align-items="center" justify-content="center" rotate=`${compassDeg(pt.current_direction_deg)}deg` aria-hidden="true"
                      svg width=22 height=22 viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width=2.5 stroke-linecap="round" stroke-linejoin="round"
                        line x1=12 y1=19 x2=12 y2=5
                        polyline points="6 11 12 5 18 11"

                  button press=toggleTechDetails width="100%" min-height=44 padding="8px 12px" border-radius=8 border="1px solid var(--border-subtle)" background-color="var(--surface-canvas)" color="var(--ink-primary)" cursor="pointer" aria-expanded=techDetailsOpen testId="toggle-tech-details"
                    row width="100%" align-items="center" justify-content="space-between"
                      text "Detail Teknis" font-size=13 font-weight=600
                      svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                        if techDetailsOpen
                          polyline points="18 15 12 9 6 15"
                        else
                          polyline points="6 9 12 15 18 9"

                  if techDetailsOpen
                    column width="100%" gap=4 padding="10px" border-radius=8 background-color="var(--surface-canvas)" border="1px solid var(--border-subtle)" testId="tech-details-panel"
                      text `Koordinat: ${pt.lat.toFixed(4)}, ${pt.lon.toFixed(4)}` font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=12 color="var(--ink-primary)" testId="inspector-coords"
                      text `Arah Kompas: ${formatOptNumber(pt.current_direction_deg, 0, "deg")} (${formatOptText(pt.current_compass, "N/A")})` font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=12 color="var(--ink-muted)"
                      match pt.salinity_psu
                        case some(sal)
                          text `Salinitas: ${sal.toFixed(2)} PSU` font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=12 color="var(--ink-muted)" testId="inspector-salinity"
                        case none
                          box display="none"
                      match pt.wave_height_m
                        case some(wh)
                          text `Tinggi Gelombang: ${wh.toFixed(2)} m` font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=12 color="var(--ink-muted)" testId="inspector-wave"
                        case none
                          box display="none"
                      text `Interpolasi: ${pt.interpolation_method} | Res: ${formatOptNumber(pt.spatial_resolution_km, 1, "km")}` font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=11 color="var(--ink-muted)"
                      text `Waktu Data (WIB): ${formatWibOpt(pt.acquired_at_utc, "Basis data lokal")}` font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=11 color="var(--ink-muted)"
                      text `Sumber: ${pt.attribution}` font-size=11 color="var(--ink-primary)"

              case none
                text "Ketuk titik laut mana saja di peta untuk melihat suhu air, kesuburan pakan alami, dan arah arus." font-size=13 line-height=1.5 color="var(--ink-muted)"

      // Slim Footer Strip: Freshness & Safety Notice
      row width="100%" flex-wrap="wrap" justify-content="space-between" align-items="center" gap=10 padding="8px 16px" background-color="var(--surface-elevated)" border-top="1px solid var(--border-subtle)" testId="ocean-map-footer"
        row flex="1 1 280px" align-items="center" gap=8 flex-wrap="wrap" testId="freshness-disclaimer-badge"
          svg width=15 height=15 viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
            circle cx=12 cy=12 r=10
            polyline points="12 6 12 12 16 14"
          text `Sumber: ${freshnessSource}` font-size=12 font-weight=700 color="var(--ink-primary)" testId="badge-data-source"
          text `Data: ${freshnessTimestamp}` font-variant-numeric="tabular-nums" font-family="var(--font-mono)" font-size=11 color="var(--ink-muted)" testId="badge-acquired-at"
        text "Data satelit & riwayat untuk referensi. Keselamatan pelayaran wajib mengikuti informasi BMKG, Pushidrosal, dan Basarnas." font-size=11 color="var(--ink-muted)" testId="badge-disclaimer-text"
